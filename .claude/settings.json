{
  "permissions": {
    "allow": [
      "Bash(git push:*)",
      "Bash(uv run ruff check .)",
      "Bash(uv run ruff check . -q)",
      "Bash(uv run ruff check src tests)",
      "Bash(uv run --group dev mypy src/familiar_agent)",
      "Bash(nvidia-smi)",
      "Bash(nvidia-smi --query-gpu *)",
      "Bash(nvidia-smi --query-compute-apps *)",
      "Bash(wpctl status)",
      "Bash(pw-dump)",
      "Bash(aplay -l)",
      "Bash(systemctl --user status *)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push --delete:*)"
    ]
  },
  "env": {
    "ARCHIFY_UPDATE_CHECK_DISABLED": "1"
  }
}
