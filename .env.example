# ──────────────────────────────────────────
# familiar-ai configuration
# Copy this file to .env and fill in your values.
# ──────────────────────────────────────────

# HuggingFace (optional)
# Suppresses rate-limit warnings from the embedding model download.
# Get a free token at https://huggingface.co/settings/tokens
HF_TOKEN=hf_...

# PostgreSQL (required)
# Start DB with: docker compose up db -d
# Then run app directly on host: uv run familiar
DATABASE_URL=postgresql://familiar:familiar@localhost:5432/familiar_ai

# Main LLM backend (required)
# API key for the main LLM (Anthropic)
API_KEY=sk-ant-...

# 家族の端末のアプリの、端末ごとの合言葉（課題9 §8.10）。「端末の名前:合言葉」を , で区切る。合言葉は ASCII の英数字と
# 記号（, は使えない）で 16 字以上（本人が決める）。あれば家の Wi-Fi から端末がつなげる（無ければ機体の中だけ）。端末を落としたら、
# その組を消して起動し直す。アプリの設定の「この端末の名前」と「合言葉」に、その端末の組を入れる。
# DEVICE_LINK_KEYS=タブレット:合言葉1,スマホ:合言葉2

# モデルの選び分け（主LLM、軽量LLM、考え方の深さ）は .env ではなく config.py の既定値で決める
# （2026-11-14。PLATFORM、MODEL、UTILITY_PLATFORM、UTILITY_MODEL、THINKING_MODE、THINKING_EFFORT は読まない）。
# 主LLM は claude-opus-5-5（会話は fast mode）、軽量LLM は claude-haiku-5-5。軽量LLM も API_KEY を使う。

# Legacy compatibility:
# ANTHROPIC_API_KEY is still read if present, but new writes should use API_KEY.

# ──────────────────────────────────────────
# Camera — ONVIF/RTSP compatible Wi-Fi camera (optional)
# Gives your familiar eyes that can look around.
# Works with any camera that supports ONVIF + RTSP (tested with Tapo C220).
#
# ⚠️  Tapo / TP-Link users: you must create a "local account" in the Tapo app
#     (Device Settings → Advanced → Camera Account) before this will work.
#     Your TP-Link cloud account credentials will NOT work here.
# ──────────────────────────────────────────
CAMERA_HOST=192.168.1.xxx
CAMERA_USERNAME=admin
CAMERA_PASSWORD=your-camera-password
CAMERA_ONVIF_PORT=2020

# Optional PTZ overrides when your RTSP stream endpoint differs from the
# ONVIF/PTZ control endpoint. Leave unset to fall back to the CAMERA_* values above.
# CAMERA_PTZ_HOST=192.168.1.xxx
# CAMERA_PTZ_USERNAME=admin
# CAMERA_PTZ_PASSWORD=your-ptz-password
# CAMERA_PTZ_PORT=2020

# ──────────────────────────────────────────
# ElevenLabs TTS (optional)
# Gives your familiar a voice.
# Get your key at https://elevenlabs.io/
# Find voice IDs at https://elevenlabs.io/voice-library
# ──────────────────────────────────────────
ELEVENLABS_API_KEY=your-elevenlabs-key
ELEVENLABS_VOICE_ID=cgSgspJ2msm6clMCkdW9
# Synthesis model (default eleven_flash_v2_5: ~0.7 s to synthesize; eleven_v3 is more expressive
# and understands [bracket] tags but takes ~5 s per reply)
#ELEVENLABS_MODEL=eleven_v3
# Extra loudness for timer announcements only (software gain on that one playback; 1.0 = off)
#TIMER_VOICE_GAIN=1.5
# Stay quiet while a timer is running and resume when it rings (default true; false = old behaviour)
#TIMER_SILENCE=true
# Stop listening while a timer runs (only timer control words — stop/pause/resume — get through)
#TIMER_MIC_CLOSE=true
# Ask once before setting a timer ("3 minutes, and I will stay quiet and not listen — ok?")
#TIMER_CONFIRM=true
# Alarm ("wake me at 7") is separate from timers: no silence, no mic close; ring length in seconds
#ALARM_RING_SEC=30
# Ring a timer sound (bundled timer_alarm.wav) for this many seconds when a timer goes off; 0 = voice only
#TIMER_RING_SEC=30
# Occupancy ("someone is here", identity unknown) = the camera saw a person within
# CAMERA_OCCUPANCY_DWELL seconds, checked every CAMERA_OCCUPANCY_INTERVAL seconds. Voices picked up
# by the microphone do NOT count (TV, noise, mis-hearing).
# Presence (who is here: a photo, a matched voice or name, /voice) is kept per person for
# PRESENCE_HOLD_SEC after the last sign of them, whether or not the camera still sees someone.
# The speaker stays known for SPEAKER_HOLD_SEC after it was set or after the agent last replied.
#CAMERA_OCCUPANCY_INTERVAL=3
#CAMERA_OCCUPANCY_DWELL=30
#PRESENCE_HOLD_SEC=60
#SPEAKER_HOLD_SEC=60
# When a voice outside the wake window is heard while someone is visible: a known (family) voice
# adds this to the BOND drive, an unknown voice adds this to the SAFETY drive. Nobody visible: nothing.
#DRIVE_VOICE_BOND_NUDGE=0.05
#DRIVE_VOICE_SAFETY_NUDGE=0.10
# A voice that reaches nobody with a registered voice at this similarity is ignored before the
# wake window (it still raises SAFETY when someone is visible). Unset = off (value not decided yet).
#VOICE_STRANGER_THRESHOLD=

# ──────────────────────────────────────────
# Realtime STT (optional)
# Always-on, hands-free voice input using ElevenLabs Scribe v2 Realtime.
# Streams microphone audio over WebSocket; VAD auto-commits transcripts.
# Requires ELEVENLABS_API_KEY above.
# ──────────────────────────────────────────
REALTIME_STT=false
# Software input gain for the mic (1.0 = off; 2.5 helps a quiet mic whose hardware volume is
# already at max). Re-read by /reload in the GUI. The mic and speaker name is config.py's
# AgentConfig.audio_device (moved out of .env on 2026-11-23).
#AUDIO_INPUT_GAIN=2.5
# Segments shorter than this (seconds) are merged into the next one (default 1.5)
#STT_MIN_SEGMENT_SEC=1.0
# Silence (seconds) that ends an utterance (default 0.6). Longer joins people's talk into one segment.
#STT_VAD_SILENCE_SEC=0.6
# While asked to stay silent, what was heard is listed to the main LLM once silence lifts;
# cap on that list in characters (default 4000)
#SILENT_HEARD_MAX_CHARS=4000

# ──────────────────────────────────────────
# ElevenLabs STT — voice input (optional)
# Reuses ELEVENLABS_API_KEY above — no extra key needed.
# Press Ctrl+M in the TUI to start/stop recording.
# ──────────────────────────────────────────
# STT_LANGUAGE=ja    # BCP-47 language code for batch + realtime transcription (default: ja)

# ──────────────────────────────────────────
# go2rtc — camera speaker playback (optional)
# Required to play TTS audio through the camera's built-in speaker.
# Without this, TTS falls back to the local PC speaker (mpv/ffplay).
#
# Setup:
#   1. Download go2rtc from https://github.com/AlexxIT/go2rtc/releases
#        go2rtc_linux_amd64
#   2. Rename and place at:
#        ~/.cache/embodied-claude/go2rtc/go2rtc   (chmod +x)
#   3. Create ~/.cache/embodied-claude/go2rtc/go2rtc.yaml:
#        streams:
#          tapo_cam:
#            - rtsp://YOUR_CAM_USER:YOUR_CAM_PASS@YOUR_CAM_IP/stream1
#   4. These env vars are optional if you use the defaults below.
# ──────────────────────────────────────────
# GO2RTC_URL=http://localhost:1984     # default
# GO2RTC_STREAM=tapo_cam              # must match the key in go2rtc.yaml

# TTS audio output destination (optional, default: local)
#   local  = PC speaker (mpv / ffplay)
#   remote = camera speaker via go2rtc (requires go2rtc setup above)
#   both   = camera speaker + PC speaker simultaneously
# TTS_OUTPUT=local

# ── 声の合成（Gemini）の鍵 ────────────────────────────────────────────────────
# 軽量LLM（要約・感情の推定など）は API_KEY で claude-haiku-5-5 を使う（config.py）。
# UTILITY_API_KEY は声の合成（Gemini）の鍵として読む（GEMINI_TTS_API_KEY が無いとき）。
# UTILITY_API_KEY=...

# ── Jev（判断専用モデル・TypeSafe AI）──────────────────────────────────────────
# 文章を書かず判断だけを型で返すモデル（出-au・`設計方針_判定の段`）。鍵が無ければ呼ばず、判定ごとの既定へ倒す。
# JEV_API_KEY=...
# JEV_MODEL=jev-latest
# JEV_TIMEOUT_SEC=2.0        # 判定を聞くときの時間切れ（超えたら判定ごとの倒し先へ）
# JEV_CONFIDENCE_MIN=0.6     # これより確信度が低い答えは使わず、倒し先へ

# ── ほかの LLM（GLM、Kimi、Gemini、OpenAI など）────────────────────────────────
# 切り替えは config.py の platform と model の既定値で行う（.env の PLATFORM、MODEL は読まない）。
# 鍵は API_KEY に置く。OpenAI 互換のローカルの口を使うときだけ BASE_URL と TOOLS_MODE を置く。

# ── Autonomous behavior (default: all OFF) ────────────────────────────────────
# By default, the agent only responds when spoken to and uses say() explicitly.
# Enable autonomous actions with these flags:
#
# FAMILIAR_AUTO=1               # enable ALL autonomous behavior
# FAMILIAR_AUTO_DESIRE=1        # enable desire-driven idle turns only

# ── Performance tuning (optional) ─────────────────────────────────────────────
# FAMILIAR_TAPE_LLM_REPLAN=1   # use LLM for TAPE replanning (default: heuristic)
# FAMILIAR_SPEECH_CHECK=1   # check each reply against the rules before speaking (extra LLM call)

# ── Scene backend — local VLM via Ollama (optional) ───────────────────────────
# Use a local vision model for camera entity extraction instead of a cloud API.
# Requires Ollama running locally: https://ollama.com
#
# Setup:
#   1. Install Ollama:  curl -fsSL https://ollama.com/install.sh | sh
#   2. Pull a vision model:  ollama pull llava:7b
#   3. Uncomment the lines below
#
# SCENE_PLATFORM=openai
# SCENE_API_KEY=local
# SCENE_BASE_URL=http://localhost:11434/v1
# SCENE_MODEL=llava:7b

# ── MCP (Model Context Protocol) ──────────────────────────────────────────────
# Optional: Connect external MCP servers to extend the agent's tools.
# Body tools (camera, TTS) stay built-in. Use MCP for everything else.
#
# Config file (same mcpServers format as Claude Code's ~/.claude.json):
#   default: ~/.familiar-ai.json
#
# Example ~/.familiar-ai.json (Brave Search — free 2,000 queries/month):
#   Get API key at: https://api.search.brave.com/  (no credit card required)
#   {
#     "mcpServers": {
#       "brave-search": {
#         "type": "stdio",
#         "command": "npx",
#         "args": ["-y", "@modelcontextprotocol/server-brave-search"],
#         "env": { "BRAVE_API_KEY": "YOUR_KEY_HERE" }
#       }
#     }
#   }
#
# MCP_CONFIG=/path/to/custom-mcp-config.json   # override default path
