# 実機テスト用のオーバーレイ env（テキストのみで試す）。
# 素の .env（秘密鍵など）の上に重ねて読まれる（FAMILIAR_ENV_FILE 指定時）。
#
# 使い方:
#   FAMILIAR_ENV_FILE=.env.quiet ./run-gui.sh
#
# ここに書いたキーだけが .env を上書きする。

# スピーカー出力を止める（合成 API も叩かない）
TTS_OUTPUT=silent

# マイク集音（リアルタイム STT）を止める
REALTIME_STT=false

# ── 診断（look 不動作の切り分け・後で戻す）───────────────────────
# 毎ターンGemini呼び出し・自発ターンを止めてイベントループ負荷を外し、lookが回復するか確認
DRIVE5_SATISFY_LLM=1
DRIVE5_AUTONOMOUS=0
